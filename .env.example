# Copy this file to .env and fill in real values. .env is gitignored.

# Supabase Postgres connection string (Settings -> Database -> Connection string -> URI)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Auth.js secret — generate with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# This same value must also be set as AUTH_SECRET in chat-server/.env.
AUTH_SECRET=""

# Supabase project URL and keys (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# URL of the standalone chat-server (see chat-server/.env.example)
NEXT_PUBLIC_CHAT_SERVER_URL="http://localhost:4000"
