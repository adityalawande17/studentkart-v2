# Copy to .env and fill in. .env is gitignored.

# Same Supabase Postgres connection string as the main app
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Must match the main app's AUTH_SECRET exactly — this is how the chat
# server verifies tokens minted by /api/chat/token
AUTH_SECRET=""

# Comma-separated list of origins allowed to connect (the Next.js app's URL)
CORS_ORIGIN="http://localhost:3000"

PORT=4000
